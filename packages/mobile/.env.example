# Mobile defaults to production: BACKEND_URL=https://ws.boardsesh.com,
# WS_URL=wss://ws.boardsesh.com/graphql, WEB_URL=https://www.boardsesh.com.
# This file is the override template — copy to .env.development.local
# only when you actually want to hit a local backend (e.g. for testing
# a websocket schema change). For day-to-day mobile work against the
# production API there is nothing to set.

# EXPO_PUBLIC_BACKEND_URL=http://localhost:8080
# EXPO_PUBLIC_WS_URL=ws://localhost:8080/graphql
# EXPO_PUBLIC_WEB_URL=http://localhost:3000

# EAS Update credentials — required for the in-app Branch Switcher to fetch
# and remap branches on preview builds. Leave unset for dev/production builds.
EXPO_PUBLIC_EAS_TOKEN=
EXPO_PUBLIC_EAS_PROJECT_ID=

# PostHog analytics. Same project token as the web app (NEXT_PUBLIC_POSTHOG_KEY)
# so a signed-in user's web + mobile activity resolves to one person. Analytics
# only sends from non-dev builds (mirrors Sentry's !__DEV__ gate), so set this as
# an EAS build-time env/secret — EXPO_PUBLIC_* vars are inlined when the bundle is
# built, not read at runtime. Host defaults to https://us.i.posthog.com.
# EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
